{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hada.invalid/schemas/project-profile.schema.json",
  "title": "Fictional Sample project profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["fictional_sample", "project_name", "purpose", "status", "template"],
  "properties": {
    "fictional_sample": { "const": true },
    "project_name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "status": { "const": "example only" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "hada-base-template" },
        "version": { "$ref": "#/$defs/version" }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
